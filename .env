# ThingsBoard Configuration
TB_HOST=thingsboard
TB_PORT=9090
TB_POSTGRES_HOST=postgres
TB_POSTGRES_PORT=5432
TB_POSTGRES_DB=thingsboard
TB_POSTGRES_USER=thingsboard
TB_POSTGRES_PASSWORD=thingsboard_password_123

# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=thingsboard
POSTGRES_USER=thingsboard
POSTGRES_PASSWORD=thingsboard_password_123
POSTGRES_ROOT_PASSWORD=root_password_123

# ThingsBoard Admin
TB_ADMIN_EMAIL=admin@thingsboard.org
TB_ADMIN_PASSWORD=admin_password_123

# Tenant Configuration
TB_TENANT_EMAIL=tenant@thingsboard.org
TB_TENANT_PASSWORD=tenant

# Security
TB_JWT_TOKEN_EXPIRATION=900
TB_JWT_REFRESH_TOKEN_EXPIRATION=604800

# API Configuration
TB_HTTP_PORT=8080
TB_MQTT_PORT=1883
TB_COAP_PORT=5683

# Database
DB_BACKUP_PATH=/backups
DB_RESTORE_PATH=/backups

# Environment
ENVIRONMENT=production
TIMEZONE=Europe/Moscow
